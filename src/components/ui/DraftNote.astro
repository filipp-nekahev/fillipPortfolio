---
// Temporary scaffolding for the alfa-travel-new draft.
// Marks content and image slots that still need Filipp's input.
// Delete this component before the page goes live.
export interface Props {
  label: string;
  image?: boolean;
}
const { label, image = false } = Astro.props;
---

{
  image ? (
    <div class="max-w-[660px] mx-auto px-[var(--container-padding)] mb-[50px]">
      <div class="border border-dashed border-[#c9c9c9] rounded-[8px] py-[60px] px-[20px] text-center text-[13px] leading-[1.5] text-[#8a8a8a]">
        <span class="uppercase tracking-[0.08em] block mb-[6px]">
          image slot
        </span>
        <slot />
        {label}
      </div>
    </div>
  ) : (
    <div class="max-w-[660px] mx-auto px-[var(--container-padding)] mb-[25px]">
      <div class="border-l-2 border-[#c9c9c9] pl-[14px] text-[13px] leading-[1.6] text-[#8a8a8a]">
        <span class="uppercase tracking-[0.08em] block mb-[4px]">to fill</span>
        <slot />
        {label}
      </div>
    </div>
  )
}
