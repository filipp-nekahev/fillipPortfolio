---
import Layout from "@/layouts/Main.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import Works from "@/components/sections/Works.astro";
import CareerPath from "@/components/sections/CareerPath.astro";
import SideProjectsScroll from "@/components/sections/SideProjectsScroll.astro";
import PersonalLife from "@/components/sections/PersonalLife.astro";
import ContactMe from "@/components/sections/ContactMe.astro";
import TopBar from "@/components/ui/TopBar.astro";

const title = "Fillip Portfolio - Home";
const description =
  "Filipp Nekhaev, Senior Product Designer and Product Builder. 10+ years designing products used by millions in travel, B2B SaaS and telecom. Open to remote roles in Europe.";
---

<Layout {title} {description}>
  <TopBar />
  <Hero id="hero" />
  <About id="about" />
  <Works id="works" />
  {/* <CareerPath id="career" /> */}
  {/* <SideProjectsScroll id="side-projects" /> */}
  <PersonalLife id="personal-life" />
  <ContactMe id="contact-me" />
</Layout>
